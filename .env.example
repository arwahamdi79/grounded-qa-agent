# Copy this file to .env and fill in real values. Never commit .env.

# --- Remote Qdrant cluster (get these from the Qdrant Cloud web UI) ---
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=langchain_qdrant_docs

# --- LLM provider for the Researcher/Reviewer agents ---
# "openai" or "anthropic"
LLM_PROVIDER=openai

# Required for embeddings regardless of LLM_PROVIDER (used to embed docs + queries)
OPENAI_API_KEY=your-openai-api-key

# Required only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Model names (optional overrides) ---
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL_OPENAI=gpt-4o-mini
CHAT_MODEL_ANTHROPIC=claude-sonnet-4-6

# --- Retrieval / agent tuning ---
RETRIEVAL_K=6
MAX_REVIEW_LOOPS=1
